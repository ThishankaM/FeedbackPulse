{
  "name": "@feedbackpulse/api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:post-migrate": "tsx scripts/post-migrate.ts",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx src/db/seed-cli.ts",
    "db:seed:reset": "tsx src/db/seed-cli.ts --reset",
    "db:reset": "npm run db:migrate && npm run db:post-migrate && npm run db:seed:reset",
    "test:db": "node scripts/db-invariants.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.13.16",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.16",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3"
  }
}
