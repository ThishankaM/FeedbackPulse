# FeedbackPulse Environment Configuration

# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/feedbackpulse

# API Server Port
PORT=3000

# Client App URL (for CORS)
CLIENT_URL=http://localhost:5173

# JWT Secret for Auth
JWT_SECRET=super-secret-feedbackpulse-development-key-change-in-prod
